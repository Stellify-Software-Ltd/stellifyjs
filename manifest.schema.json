{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stellify.dev/schemas/framework-api.json",
  "title": "StellifyJS Framework API Manifest",
  "description": "Schema for the auto-generated framework API manifest",
  "type": "object",
  "required": ["version", "generatedAt", "composables", "utilities", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Package version (semver)",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?(\\+[a-zA-Z0-9.-]+)?$"
    },
    "generatedAt": {
      "type": "string",
      "description": "ISO 8601 timestamp of generation",
      "format": "date-time"
    },
    "composables": {
      "type": "object",
      "description": "Vue composables (useX functions)",
      "additionalProperties": {
        "$ref": "#/definitions/composable"
      }
    },
    "utilities": {
      "type": "object",
      "description": "Utility classes and functions",
      "additionalProperties": {
        "$ref": "#/definitions/utility"
      }
    },
    "rules": {
      "type": "array",
      "description": "Validation rule factories",
      "items": {
        "$ref": "#/definitions/ruleFactory"
      }
    }
  },
  "definitions": {
    "composable": {
      "type": "object",
      "required": ["summary", "options", "returns"],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "description": "Brief description from JSDoc"
        },
        "options": {
          "type": "array",
          "description": "Options/parameters the composable accepts",
          "items": {
            "$ref": "#/definitions/optionField"
          }
        },
        "returns": {
          "type": "array",
          "description": "Fields returned by the composable",
          "items": {
            "$ref": "#/definitions/returnField"
          }
        }
      }
    },
    "optionField": {
      "type": "object",
      "required": ["name", "type", "required"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Field name"
        },
        "type": {
          "type": "string",
          "description": "TypeScript type"
        },
        "required": {
          "type": "boolean",
          "description": "Whether the field is required"
        },
        "description": {
          "type": "string",
          "description": "Field description from JSDoc"
        }
      }
    },
    "returnField": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Field name"
        },
        "type": {
          "type": "string",
          "description": "TypeScript type"
        },
        "description": {
          "type": "string",
          "description": "Field description from JSDoc"
        }
      }
    },
    "utility": {
      "type": "object",
      "required": ["summary", "methods"],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "description": "Brief description from JSDoc"
        },
        "methods": {
          "type": "array",
          "description": "Public methods",
          "items": {
            "$ref": "#/definitions/method"
          }
        },
        "staticMethods": {
          "type": "array",
          "description": "Static methods",
          "items": {
            "$ref": "#/definitions/method"
          }
        }
      }
    },
    "method": {
      "type": "object",
      "required": ["name", "signature"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Method name"
        },
        "signature": {
          "type": "string",
          "description": "Method signature"
        },
        "description": {
          "type": "string",
          "description": "Method description from JSDoc"
        }
      }
    },
    "ruleFactory": {
      "type": "object",
      "required": ["name", "signature"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Rule factory name"
        },
        "signature": {
          "type": "string",
          "description": "Function signature"
        },
        "description": {
          "type": "string",
          "description": "Rule description from JSDoc"
        }
      }
    }
  }
}
